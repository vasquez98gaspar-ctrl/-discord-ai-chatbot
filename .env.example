# Copy this file and rename it to ".env"
# Then paste your real keys in (no quotes needed).
# The .env file is gitignored so it stays private.

DISCORD_TOKEN=your_discord_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — enables persistent per-user memory across restarts.
# Leave unset to run without a database (memory just won't persist).
DATABASE_URL=
